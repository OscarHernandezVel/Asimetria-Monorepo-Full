# Borde TLS de producción. Caddy obtiene y renueva solo los certificados de Let's Encrypt.
# Variables (desde .env): DOMINIO=asimetria.tudominio.com  ACME_EMAIL=tu-correo
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$DOMINIO} {
	# RNF-03: solo TLS 1.3. HSTS obliga a los navegadores a usar siempre HTTPS.
	tls {
		protocols tls1.3
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	reverse_proxy web:80 {
		health_uri /index.html
		health_interval 30s
	}
	log {
		output stdout
		format json
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
