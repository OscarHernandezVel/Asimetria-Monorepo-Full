# Copia este archivo a .env y cambia los secretos. .env nunca se versiona (HU-01 CA-1).
POSTGRES_PASSWORD=cambia-esta-clave
JWT_SECRET=genera-uno-con-python-c-import-secrets-print-secrets.token_urlsafe-48
JWT_MINUTOS=120
BCRYPT_ROUNDS=12
# simulado (sin API key, datos deterministas) | alphavantage (requiere ALPHAVANTAGE_API_KEY; usa INTERVALO_COTIZACIONES >= 60)
PROVEEDOR=simulado
ALPHAVANTAGE_API_KEY=
# Tope local de llamadas diarias a Alpha Vantage (plan gratuito ≈ 25/día); al llegar se usan los datos almacenados
AV_LIMITE_DIARIO=25
# Opcional: correo real de alertas
SENDGRID_API_KEY=
CORREO_REMITENTE=alertas@asimetria.app
INTERVALO_COTIZACIONES=5
CACHE_TTL=300
# 1 = botón "Ver demo en vivo" (cuenta demo compartida). En un despliegue público de presentación puede quedar en 1.
MODO_DEMO=1
# 1 = inyección de fallos y prueba de integraciones (afectan a TODOS los usuarios). En producción: 0
HERRAMIENTAS_PRUEBA=1

# ---- Solo producción (docker-compose.prod.yml) ----
# Dominio público (registro DNS A apuntando al servidor) y correo para Let's Encrypt
DOMINIO=asimetria.tudominio.com
ACME_EMAIL=tu-correo@dominio.com
# Imágenes publicadas por GitHub Actions; TAG lo fija el despliegue (sha del commit)
REGISTRO=ghcr.io/oscarhernandezvel
TAG=latest
# Procesos de la API por contenedor (≈ núcleos de CPU del servidor; 4 workers × 20 conexiones ≤ 100 de PostgreSQL)
UVICORN_WORKERS=2
